{
  "name": "root",
  "private": true,
  "version": "1.0,0",
  "scripts": {
    "build": "lerna run build --parallel",
    "dev": "lerna run dev --parallel",
    "start": "lerna run start --parallel",
    "format": "lerna run format",
    "build-sanity": "lerna bootstrap && cd packages/studio && npm run build",
    "build-web": "lerna bootstrap && (cd packages/studio && npm run graphql-deploy) && (cd packages/site/ozarkedge-website && npm run build)",
    "graphql-deploy": "lerna run graphql-deploy",
    "lint": "lerna run lint",
    "postinstall": "lerna bootstrap",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "lerna": "^4.0.0"
  },
  "dependencies": {
    "next-sanity": "^0.5.0"
  }
}
