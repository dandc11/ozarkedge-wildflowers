{
  "extends": ["next", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "env": {
    "es6": true
  },
  "plugins": ["import"],
  "rules": {
    "import/no-unresolved": "error",
    "import/order": [
      "warn",
      {
        "newlines-between": "always"
      }
    ],
    "react/display-name": "off"
  },
  "settings": {
    "import/resolver": {
      "node": {
        "paths": ["src"],
        "extensions": [".js", ".jsx", ".ts", ".tsx"]
      }
    }
  }
}
