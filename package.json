{
  "name": "ozarkedge-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next",
    "format": "npx prettier --write . --ignore-path .gitignore",
    "lint": "eslint .",
    "lint:fix": "npm run format && npm run lint -- --fix",
    "migrate": "sanity exec migrations/rename-pagebodyportabletext-objects/index.ts --with-user-token",
    "start": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:run": "jest --passWithNoTests --no-watch --verbose",
    "test:integration": "jest --testPathPattern=tests/integration",
    "sanity:backup": "sanity dataset export prod backups/backup-$(date +%Y%m%d-%H%M%S).tar.gz",
    "sanity:backup-json": "sanity dataset export prod backups/backup-$(date +%Y%m%d-%H%M%S).json",
    "sanity:backup-script": "node scripts/backup-sanity.js",
    "sanity:sync-dev": "sanity dataset export prod .sanity-dev-sync.tar.gz --overwrite && sanity dataset import .sanity-dev-sync.tar.gz dev --replace && rm .sanity-dev-sync.tar.gz"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "singleQuote": true
  },
  "dependencies": {
    "@mux/mux-player-react": "^3.4.0",
    "@next/env": "16.2.10",
    "@portabletext/react": "^6.2.0",
    "@sanity/client": "^7.20.0",
    "@sanity/image-url": "^2.0.0",
    "@sanity/ui": "^3.1.14",
    "@sanity/vision": "^5.31.1",
    "@testing-library/dom": "^10.4.1",
    "@vercel/analytics": "^1.5.0",
    "classnames": "^2.3.2",
    "cors": "^2.8.5",
    "framer-motion": "^12.15.0",
    "lightbox.js-react": "^1.5.6",
    "next": "16.2.10",
    "next-sanity": "^13.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-select": "^5.8.0",
    "sanity": "^5.31.1",
    "sanity-plugin-media": "^4.1.1",
    "sanity-plugin-mux-input": "^2.8.0",
    "styled-components": "^6.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.10",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "autoprefixer": "^10.4.13",
    "cross-env": "^10.1.0",
    "cssnano": "^7.0.6",
    "eslint-config-next": "^16.2.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.30.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.4.21",
    "postcss-import": "^15.1.0",
    "postcss-nesting": "^12.0.1",
    "typescript": "5.2.2"
  },
  "engines": {
    "node": "22.x"
  }
}
