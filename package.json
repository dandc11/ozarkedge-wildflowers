{
  "name": "ozarkedge-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:prod": "next build && next export",
    "dev": "next",
    "format": "npx prettier --write . --ignore-path .gitignore",
    "lint": "next lint -- --ignore-path .gitignore",
    "lint:fix": "npm run format && npm run lint -- --fix",
    "migrate": "sanity exec migrations/rename-pagebodyportabletext-objects/index.ts --with-user-token",
    "start": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "sanity:backup": "sanity dataset export prod backups/backup-$(date +%Y%m%d-%H%M%S).tar.gz",
    "sanity:backup-json": "sanity dataset export prod backups/backup-$(date +%Y%m%d-%H%M%S).json",
    "sanity:backup-script": "node scripts/backup-sanity.js"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "singleQuote": true
  },
  "dependencies": {
    "@mux/mux-player-react": "^3.4.0",
    "@next/env": "^14.2.3",
    "@portabletext/react": "^3.0.4",
    "@sanity/client": "^6.25.0",
    "@sanity/image-url": "^1.0.2",
    "@sanity/ui": "^2.15.18",
    "@sanity/vision": "^3.56.0",
    "@vercel/analytics": "^1.5.0",
    "classnames": "^2.3.2",
    "cors": "^2.8.5",
    "framer-motion": "^12.15.0",
    "lightbox.js-react": "^1.5.6",
    "next": "^14.2.7",
    "next-sanity": "^9.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.10.1",
    "react-select": "^5.8.0",
    "sanity": "^3.90.0",
    "sanity-image": "^1.0.0",
    "sanity-plugin-iframe-pane": "^3.1.6",
    "sanity-plugin-media": "^2.3.2",
    "sanity-plugin-mux-input": "^2.8.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.3.4",
    "autoprefixer": "^10.4.13",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.6",
    "eslint-config-next": "^14.2.7",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.30.0",
    "postcss": "^8.4.21",
    "postcss-import": "^15.1.0",
    "postcss-nesting": "^12.0.1",
    "typescript": "5.2.2"
  }
}
